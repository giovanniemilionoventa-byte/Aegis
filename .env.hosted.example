# Settings for docker-compose.hosted.yml. Do NOT fill this in by hand:
#   bash scripts/deploy-hosted.sh
# writes a real .env (gitignored) with fresh secrets. This file only documents it.

# --- Where it lives (two DNS A records must point at this server) ---------------
APP_DOMAIN=app.yourdomain.tld          # the dashboard people open
GATEWAY_DOMAIN=gateway.yourdomain.tld  # the address customers' agents call
ACME_EMAIL=you@yourdomain.tld          # Let's Encrypt contact

# --- Secrets (generated; production refuses defaults, placeholders and < 32 chars) ---
AEGIS_SECRET_KEY=
AEGIS_EAT_KEY=
AEGIS_EVIDENCE_SECRET_KEY=

# --- Who may register: a comma-separated list. Empty means registration is closed. ---
AEGIS_INVITE_CODES=

# --- Approval emails (optional). Without a host nothing is sent; the dashboard still shows everything. ---
AEGIS_SMTP_HOST=
AEGIS_SMTP_PORT=587
AEGIS_SMTP_USER=
AEGIS_SMTP_PASSWORD=
AEGIS_SMTP_FROM=
